# Google: service account JSON key path. Powers GA4 + Search Console.
# See PLAN.md section 8 for the console steps.
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.local.json

# Microsoft Clarity data export token.
CLARITY_TOKEN=

# Crawl provider. Firecrawl is the shipped default.
FIRECRAWL_API_KEY=
CONTEXT_DEV_API_KEY=

# Optional. Free key, raises PageSpeed Insights rate limits.
PAGESPEED_API_KEY=

# Optional. Defaults to the repo paydirt runs in.
PAYDIRT_TARGET_REPO=
