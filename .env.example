# Google: service account JSON key path. Powers GA4 + Search Console.
# See PLAN.md section 8 for the console steps.
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.local.json

# Microsoft Clarity data export token.
CLARITY_TOKEN=

# Crawl provider. Firecrawl is the shipped default.
FIRECRAWL_API_KEY=
CONTEXT_DEV_API_KEY=

# Optional. Free key, raises PageSpeed Insights rate limits.
PAGESPEED_API_KEY=

# Optional. Defaults to the repo rainmaker runs in.
RAINMAKER_TARGET_REPO=

# Model provider for `rainmaker agent` and AI citation probes. Anthropic is
# tried first, then OpenAI. Neither is needed for an audit.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Overrides the default model id for whichever provider is selected.
RAINMAKER_MODEL=

# Optional. Point either at a compatible endpoint instead of the vendor's own.
# OPENAI_BASE_URL is the general-purpose one: anything speaking the OpenAI
# chat-completions shape works through it, including OpenRouter, Groq, Gemini's
# compatibility endpoint, Ollama, LM Studio and vLLM.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
