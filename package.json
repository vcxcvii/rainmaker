{
  "name": "paydirt",
  "version": "0.1.0",
  "description": "GTM-native SEO and AI-search system. Ranks every finding by distance to revenue, not technical severity.",
  "type": "module",
  "bin": {
    "paydirt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "paydirt.config.example.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "init": "tsx src/cli.ts init",
    "doctor": "tsx src/cli.ts doctor",
    "audit": "tsx src/cli.ts audit",
    "fetch": "tsx src/cli.ts fetch",
    "report": "tsx src/cli.ts report",
    "routine": "tsx src/cli.ts routine",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "seo",
    "aeo",
    "geo",
    "gtm",
    "content-marketing",
    "google-search-console",
    "ga4"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
